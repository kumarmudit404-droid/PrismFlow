# PrismFlow V2 — Environment Configuration
# Copy this to .env and fill in your API keys
# DO NOT commit .env — only .env.template

# Anthropic (Claude API)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (for angle diversification in Part 20)
OPENAI_API_KEY=sk-...

# GitHub (Tech Angle data retrieval)
GITHUB_TOKEN=ghp_...

# NewsAPI (Market Angle data retrieval)
NEWSAPI_KEY=...

# Yahoo Finance (Financial Angle — usually free, no key required)
YFINANCE_COOKIE=      # Optional; yahoo-fin has rate limits without cookie

# Alpha Vantage (Financial supplementary)
ALPHA_VANTAGE_KEY=    # Optional; fall back to yfinance if missing

# Reddit (Sentiment Angle — PRAW)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=PrismFlow/2.0 (by Mudit Kumar)

# arXiv (Tech Angle supplementary)
# Note: arXiv does not require API key; requests must have User-Agent header

# Local development
DEBUG=false
LOG_LEVEL=INFO
CACHE_DIR=./cache/v2
RESULTS_DIR=./results/v2

# Database (Part 18 cache layer)
CACHE_DB=sqlite:///./cache/v2/prismflow_cache.db

# Streamlit (Part 25)
STREAMLIT_SERVER_PORT=8501
