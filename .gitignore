# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# PrismFlow generated outputs (not source)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
# experiments/ holds experiment SOURCE code, which must be tracked -- only
# its generated artefacts are ignored.
experiments/**/outputs/

# results/ holds findings. Reported numbers and figures are tracked so a
# claim stays linked to the commit that produced it; bulk artefacts are not.
results/*
!results/.gitkeep
# Part 16 writes results/final_summary.{json,csv} at the TOP level. Every
# un-ignore below starts one directory deep, so without this zero-level rule
# those two files are silently untracked -- the same failure as 54bb6d7 and
# c012d21, one level shallower instead of deeper.
!results/*.json
!results/*.csv
!results/*.md
!results/*.png
!results/*/
results/*/*
!results/*/*.json
!results/*/*.csv
!results/*/*.md
!results/*/*.png
# evaluate() writes results/<experiment>/<system>/: same policy, one level down.
!results/*/*/
results/*/*/*
!results/*/*/*.json
!results/*/*/*.csv
!results/*/*/*.md
!results/*/*/*.png
# Part 15 nests one deeper again: results/real/<dataset>/<condition>/, because
# the experiment id passed to evaluate() already carries a dataset segment.
# Same policy, one more level down. The trailing-slash un-ignore is required,
# not decorative: git does not descend into an ignored directory, so without
# `!results/*/*/*/` the file patterns below are never reached.
!results/*/*/*/
results/*/*/*/*
!results/*/*/*/*.json
!results/*/*/*/*.csv
!results/*/*/*/*.md
!results/*/*/*/*.png
# ...and one level beyond that, because Part 15's experiment id is
# `real/<dataset>/comparison/<condition>`, which puts evaluate()'s own output
# five deep: results/real/handwritten/comparison/clean/metrics.json. Four
# levels reaches the `comparison/` directory but stops short of the files.
!results/*/*/*/*/
results/*/*/*/*/*
!results/*/*/*/*/*.json
!results/*/*/*/*/*.csv
!results/*/*/*/*/*.md
!results/*/*/*/*/*.png
# --quick smoke runs write to results/<name>_quick/ so they can never
# overwrite committed 5-seed evidence. That output is never a finding:
# ignore it outright, ahead of the per-extension un-ignores above.
results/*_quick/

logs/*
!logs/.gitkeep
checkpoints/*
!checkpoints/.gitkeep

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# PrismFlow V2 — Secrets & Environment
.env
.env.local
.env.*.local

# API credentials
credentials/
*.key
*.pem

# V2 cache
cache/v2/

# Generated documentation exports, not source. Named individually rather than
# by *.pdf because PrismFlow_Master_Project_and_Claude_Prompts.pdf and
# PrismFlow_Technical_Overview.pdf ARE tracked source.
/PrismFlow_File_Catalog.pdf
/PrismFlow_Interview_Guide.pdf
