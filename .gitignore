# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# PrismFlow generated outputs (not source)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
# experiments/ holds experiment SOURCE code, which must be tracked -- only
# its generated artefacts are ignored.
experiments/**/outputs/

# results/ holds findings. Reported numbers and figures are tracked so a
# claim stays linked to the commit that produced it; bulk artefacts are not.
results/*
!results/.gitkeep
!results/*/
results/*/*
!results/*/*.json
!results/*/*.csv
!results/*/*.md
!results/*/*.png
# evaluate() writes results/<experiment>/<system>/: same policy, one level down.
!results/*/*/
results/*/*/*
!results/*/*/*.json
!results/*/*/*.csv
!results/*/*/*.md
!results/*/*/*.png
logs/*
!logs/.gitkeep
checkpoints/*
!checkpoints/.gitkeep

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
