# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# PrismFlow generated outputs (not source)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
# experiments/ holds experiment SOURCE code, which must be tracked -- only
# its generated artefacts are ignored.
experiments/**/outputs/

# results/ holds findings. Reported numbers and figures are tracked so a
# claim stays linked to the commit that produced it; bulk artefacts are not.
results/*
!results/.gitkeep
# Part 16 writes results/final_summary.{json,csv} at the TOP level. Every
# un-ignore below starts one directory deep, so without this zero-level rule
# those two files are silently untracked -- the same failure as 54bb6d7 and
# c012d21, one level shallower instead of deeper.
!results/*.json
!results/*.csv
!results/*.md
!results/*.png
!results/*/
results/*/*
!results/*/*.json
results/ait_attack/results.json
results/ait_attack/results.3of4units_20261014_0022.json
# Part 29's two large result files are committed as gzip (-9): 25.69 MB and
# 17.44 MB raw, against 0.40 MB for the largest results file tracked anywhere
# else here. results_manifest.json pins the sha256 of the DECOMPRESSED json.
!results/*/*.json.gz
!results/*/*.csv
!results/*/*.md
!results/*/*.png
# evaluate() writes results/<experiment>/<system>/: same policy, one level down.
!results/*/*/
results/*/*/*
!results/*/*/*.json
!results/*/*/*.csv
!results/*/*/*.md
!results/*/*/*.png
# Part 15 nests one deeper again: results/real/<dataset>/<condition>/, because
# the experiment id passed to evaluate() already carries a dataset segment.
# Same policy, one more level down. The trailing-slash un-ignore is required,
# not decorative: git does not descend into an ignored directory, so without
# `!results/*/*/*/` the file patterns below are never reached.
!results/*/*/*/
results/*/*/*/*
!results/*/*/*/*.json
!results/*/*/*/*.csv
!results/*/*/*/*.md
!results/*/*/*/*.png
# ...and one level beyond that, because Part 15's experiment id is
# `real/<dataset>/comparison/<condition>`, which puts evaluate()'s own output
# five deep: results/real/handwritten/comparison/clean/metrics.json. Four
# levels reaches the `comparison/` directory but stops short of the files.
!results/*/*/*/*/
results/*/*/*/*/*
!results/*/*/*/*/*.json
!results/*/*/*/*/*.csv
!results/*/*/*/*/*.md
!results/*/*/*/*/*.png
# --quick smoke runs write to results/<name>_quick/ so they can never
# overwrite committed 5-seed evidence. That output is never a finding:
# ignore it outright, ahead of the per-extension un-ignores above.
results/*_quick/

logs/*
!logs/.gitkeep
checkpoints/*
!checkpoints/.gitkeep

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
# VS Code's Code Runner scratch file. Written wherever the run was triggered.
tempCodeRunnerFile.*

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# PrismFlow V2 — Secrets & Environment
.env
.env.local
.env.*.local

# API credentials
credentials/
*.key
*.pem

# V2 cache
cache/v2/

# Generated documentation exports, not source. Ignore every root-level PDF and
# name the two exceptions, rather than listing the exports one at a time: the
# next export anyone produces is then ignored by default instead of waiting to
# be added here after it has already been staged once.
/*.pdf
!/PrismFlow_Master_Project_and_Claude_Prompts.pdf
!/PrismFlow_Technical_Overview.pdf

# Scratch images kept on disk for reference. Never part of the site, which
# serves only what is under web/assets/img/.
/PICtures/

# Part 24 extractor fetch cache (re-creatable from the live APIs)
scripts/.part24_cache/

# The incoming 49-row workbook, now merged into the tracked dataset. Kept on
# disk as the audit trail for row 040, the one row no source could confirm.
data/v2/part24_labeled_dataset_completed.xlsx

# The deploy build. web/build_dist.py writes it from the tracked sources on
# demand, so committing it would be a second copy of the site that can drift
# from the one being reviewed.
web/dist/
